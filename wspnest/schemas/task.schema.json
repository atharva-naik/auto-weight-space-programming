{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSPNest task card",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "kind",
    "auto",
    "track",
    "summary",
    "credit",
    "license",
    "data",
    "metric",
    "baselines",
    "entrypoint",
    "canary",
    "test"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "major: scores not comparable; minor: new items or splits; patch: fixes that keep scores comparable"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "read",
        "write",
        "localize"
      ]
    },
    "auto": {
      "type": "boolean",
      "description": "true if the model reads or edits its own weights (auto-WSP)"
    },
    "track": {
      "enum": [
        "frontier",
        "core",
        "retired"
      ]
    },
    "summary": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "target models the task is defined on"
    },
    "credit": {
      "type": "object",
      "required": [
        "source",
        "authors",
        "citation"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citation": {
          "type": "string"
        },
        "adapted_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "data",
        "redistributed"
      ],
      "properties": {
        "data": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "redistributed": {
          "type": "boolean",
          "description": "false: the task fetches data from the original source instead of copying it"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "splits": {
          "type": "object"
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "chance"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "chance": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "description": "python file, relative to the task folder, defining generate(out, **options) -> int, which writes Harbor task directories"
    },
    "notes": {
      "type": "string"
    },
    "canary": {
      "type": "string",
      "description": "the suite's canary GUID (see CANARY); every task file and dataset card must include it"
    },
    "runtime": {
      "type": "string",
      "description": "how the task runs under Harbor (variants, agents, GPU needs)"
    },
    "test": {
      "type": "object",
      "required": [
        "frozen"
      ],
      "description": "the test version: every task has one; pinned and frozen for reproduction, carries the canary, and is what releases score",
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "pinned": {
          "type": "string",
          "description": "what pins it (dataset revision, upstream commit, seeds)"
        }
      }
    },
    "train": {
      "type": "object",
      "required": [
        "entrypoint",
        "disjoint_from_test"
      ],
      "description": "optional train version, for gym-like tasks: a generator of training data, provably disjoint from the test version and WITHOUT the canary. Tasks with only a test version have no training data.",
      "properties": {
        "entrypoint": {
          "type": "string",
          "description": "function in the task's entrypoint file: generate_train(out, **options) -> int"
        },
        "disjoint_from_test": {
          "type": "string",
          "description": "how disjointness is guaranteed (reserved seed ranges, held-out neurons, ...)"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "type": "object",
      "required": [
        "upstream",
        "commit",
        "consent",
        "parity"
      ],
      "description": "present for benchmark adapters only",
      "properties": {
        "upstream": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "consent": {
          "type": "object",
          "required": [
            "by",
            "date",
            "revocable"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "revocable": {
              "type": "boolean"
            },
            "scope": {
              "type": "string"
            }
          }
        },
        "parity": {
          "type": "object",
          "required": [
            "file",
            "match"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "match": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
